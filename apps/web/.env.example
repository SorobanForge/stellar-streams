# Stellar Network Settings
# Supported: local, testnet, mainnet
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Horizon API endpoint
# Testnet: https://horizon-testnet.stellar.org
# Local:   http://localhost:8000
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC endpoint
# Testnet: https://soroban-testnet.stellar.org
# Local:   http://localhost:8000/soroban/rpc
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase (must match the network above)
# Testnet: "Test SDF Network ; September 2015"
# Mainnet: "Public Global Stellar Network ; September 2015"
# Local:   "Standalone Network ; February 2017"
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Contract addresses (filled in automatically by `pnpm deploy:testnet`).
# Placeholders — leave blank until you have run a deployment.
NEXT_PUBLIC_STREAM_CONTRACT_ID=
NEXT_PUBLIC_SPLITS_CONTRACT_ID=
NEXT_PUBLIC_ESCROW_CONTRACT_ID=

# Token contract to stream. This default is the Stellar testnet native XLM (SAC).
NEXT_PUBLIC_TOKEN_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Block explorer base used to build transaction / contract links in the dashboard.
# Testnet: https://stellar.expert/explorer/testnet
# Mainnet: https://stellar.expert/explorer/public
NEXT_PUBLIC_STELLAR_EXPERT_URL=https://stellar.expert/explorer/testnet
