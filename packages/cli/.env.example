# Stellar Streams CLI Configuration

# Your Stellar secret key (starts with 'S')
# NEVER commit this to version control!
# Get a testnet account at: https://laboratory.stellar.org/#account-creator?network=test
STELLAR_STREAMS_SECRET_KEY=SBAD0000000000000000000000000000000000000000000000000000000

# The deployed Streams contract ID
# Fill this in after running `pnpm deploy:testnet`
STELLAR_STREAMS_CONTRACT_ID=CTEST0000000000000000000000000000000000000000000000000000000

# Network to use (local, testnet, or mainnet)
# Can also be set via the --network flag on the command line
# Default: testnet
STELLAR_STREAMS_NETWORK=testnet
