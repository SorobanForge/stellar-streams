{
  "name": "@stellar-starter-kit/cli",
  "version": "0.1.0",
  "private": true,
  "description": "CLI for stellar-streams: script stream and split operations",
  "type": "module",
  "bin": {
    "stellar-streams": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@stellar-starter-kit/contracts": "workspace:*",
    "@stellar-starter-kit/sdk": "workspace:*",
    "@stellar-starter-kit/types": "workspace:*",
    "@stellar/stellar-sdk": "^14.5.0"
  },
  "devDependencies": {
    "@stellar-starter-kit/tsconfig": "workspace:*",
    "@stellar-starter-kit/eslint-config": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^1.0.0"
  }
}
