{
  "name": "@stellar-starter-kit/types",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@stellar-starter-kit/utils": "workspace:*",
    "@stellar/stellar-sdk": "^14.5.0"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",

    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@stellar-starter-kit/tsconfig": "workspace:*",
    "@stellar-starter-kit/eslint-config": "workspace:*",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2",

    "@vitest/coverage-v8": "^5.1.2"
  }
}
