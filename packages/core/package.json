  },
  "devDependencies": {
    "@stellar-starter-kit/tsconfig": "workspace:*",
    "@stellar-starter-kit/eslint-config": "workspace:*",
    "@types/node": "^26.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",

    "@vitest/coverage-v8": "^4.1.12"
  }
}
