{
  "name": "@stellar-starter-kit/core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared network configuration and environment resolution for Stellar Streams.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --ext .ts,.tsx",
