{
  "name": "@stellar-starter-kit/config",
  "version": "0.1.0",
  "description": "Typed environment configuration and validation for Stellar Streams",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",

    "test:coverage": "vitest run --coverage",
    "test:run": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "@stellar-starter-kit/tsconfig": "workspace:*",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2",

    "@vitest/coverage-v8": "^5.1.2"
  }
}
