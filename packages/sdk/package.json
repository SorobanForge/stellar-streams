{
  "name": "@stellar-starter-kit/sdk",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/record-rpc-fixtures.ts --check && vitest run",
    "fixtures:record": "node scripts/record-rpc-fixtures.ts",
    "fixtures:check": "node scripts/record-rpc-fixtures.ts --check",
    "docs": "typedoc"
  },
  "dependencies": {
    "@stellar-starter-kit/types": "workspace:*",
    "@stellar/stellar-sdk": "^14.5.0"
  },
  "devDependencies": {
    "@stellar-starter-kit/tsconfig": "workspace:*",
    "@stellar-starter-kit/eslint-config": "workspace:*",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
