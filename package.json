{
  "name": "stellar-streams-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Payment streaming, vesting, and splits protocol for Stellar and Soroban.",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-package-manager.js",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:exports": "node scripts/check-package-entries.mjs",
    "test:contracts": "cargo test --manifest-path contracts/Cargo.toml",
    "lint:contracts": "cargo clippy --manifest-path contracts/Cargo.toml --all-targets -- -D warnings",
    "fmt:contracts": "cargo fmt --manifest-path contracts/Cargo.toml --all -- --check",
    "node:local": "docker compose up -d",
    "node:stop": "docker compose down",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release-packages": "changeset publish",
    "download:cli": "node scripts/run.js download-stellar-cli",
    "build:contracts": "node scripts/run.js build-contracts",
    "optimize": "node scripts/run.js optimize-contracts",
    "generate:bindings": "node scripts/run.js generate-bindings",
    "create:issues": "./scripts/create-issues.sh",
    "repo:protect": "./scripts/setup-branch-protection.sh",
    "repo:topics": "./scripts/set-topics.sh",
    "deploy:testnet": "node scripts/run.js deploy-contracts",
    "deploy:stream": "node scripts/run.js deploy-contracts",
    "deploy:splits": "node scripts/run.js deploy-contracts",
    "deploy:escrow": "node scripts/run.js deploy-contracts",
    "invoke:stream": "node scripts/run.js invoke-stream",
    "invoke:escrow": "node scripts/run.js invoke-escrow"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@stellar-starter-kit/eslint-config": "workspace:*",
    "@types/react": "^19.0.0",
    "eslint": "^9.39.5",
    "husky": "^9.0.11",
    "lint-staged": "^17.2.0",
    "prettier": "3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.0.0",
    "turbo": "^2.10.5",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@9.4.0",
  "lint-staged": {
    "!(*.d).{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.d.ts": [
      "prettier --write"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  }
}
