# Soroban RPC endpoint
# Testnet: https://soroban-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase
# Testnet: "Test SDF Network ; September 2015"
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Deployed stream contract ID on Testnet
# Get this from docs/deployments.md or from a successful deployment with `pnpm deploy:stream`
STREAM_CONTRACT_ID=C...

# Sender's Stellar secret key (starts with S)
# ⚠️  NEVER commit this to version control. Use a test account with minimal funds.
# Generate a new keypair: https://laboratory.stellar.org/#account-creator?network=testnet
SENDER_SEED=S...

# Recipient's Stellar public key (starts with G)
# This is who will receive the vested payments
RECIPIENT_ADDRESS=G...

# Optional: XLM token contract (SAC - Stellar Asset Contract)
# Default is the Testnet XLM. Only override if streaming a different asset.
# Testnet XLM: CDLZFC3SYJYDZT7K67VZ75HPJGWGN6XXU250DEX2ZJ26C6EU5R144Z7X
# TOKEN_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJGWGN6XXU250DEX2ZJ26C6EU5R144Z7X
